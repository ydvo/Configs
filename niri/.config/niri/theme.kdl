// Main highlight: Amazon Leo / Kuiper purple (#B499FF).
// Swap #B499FF (and the dim #5C00D3) if your team brand guide specifies another purple.
layout {

    focus-ring {
        active-color   "#B499FF"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#B499FF"
        inactive-color "#131313"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#B499FF"
        inactive-color "#5C00D3"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#B499FF80"
    }
}

recent-windows {
    highlight {
        active-color "#B499FF"
        urgent-color "#ffb4ab"
    }
}
